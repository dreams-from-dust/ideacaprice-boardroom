# Copy this file to .env (or .env.local) and fill in your real key.
# NEVER commit the real file. NEVER prefix this with VITE_ — any env var
# prefixed VITE_ gets inlined into the client-side JS bundle by Vite at build
# time, which means it would ship inside the compiled app/APK and be
# extractable by anyone. This key must stay server-only.

GROQ_API_KEY=your_groq_api_key_here

# Only needed when building the Android APK. Leave this UNSET for normal web
# use (dev or deployed website) — a relative path works fine there because
# the page and the API share an origin. Inside the compiled APK there is no
# server at that origin, so this must point at your deployed backend before
# running `npm run build` for a native build, e.g.:
# VITE_API_BASE_URL=https://your-app.onrender.com
# This one is safe to expose client-side (it's just a URL, not a secret),
# unlike GROQ_API_KEY above — so the VITE_ prefix here is intentional.
VITE_API_BASE_URL=

# Note: Firebase config lives in firebase-applet-config.json (already
# committed) rather than env vars — that's fine, Firebase web config values
# are public by design. Security comes from firestore.rules, not from hiding
# these values.
